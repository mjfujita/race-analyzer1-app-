{
  "name": "race-analyzer-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "push-db": "node scripts/push_db.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src dev tests server api --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "data:run": "python3 -m pipeline.run run",
    "test:pipeline": "python3 -m unittest pipeline.test_pipeline pipeline.test_prediction pipeline.test_review collector.test_collector -v"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "lucide-react": "^1.16.0",
    "qrcode": "1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sql.js": "^1.13.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.10"
  }
}
